{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend"],
      "port": 3000
    },
    {
      "name": "backend-api",
      "runtimeExecutable": "php",
      "runtimeArgs": ["backend/artisan", "serve"],
      "port": 8000
    },
    {
      "name": "site-static",
      "runtimeExecutable": "php",
      "runtimeArgs": ["-S", "localhost:4173", "-t", "site/public"],
      "port": 4173
    }
  ]
}
